{
  "name": "humandnavisualizer-frontend",
  "version": "1.0.0",
  "description": "Frontend for HumanDNAVisualizer - Interactive 3D DNA visualization and analysis",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:legal": "node ../scripts/legal-lint.js",
    "lint:legal:verbose": "node ../scripts/legal-lint.js --verbose",
    "test:legal": "node ../scripts/__tests__/legal-lint.test.js"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "three": "0.158.0",
    "@react-three/fiber": "8.15.11",
    "@react-three/drei": "9.92.5",
    "axios": "1.6.0",
    "react-router-dom": "6.18.0",
    "socket.io-client": "4.7.2",
    "plotly.js": "2.27.0",
    "react-plotly.js": "2.6.0",
    "dompurify": "3.0.6",
    "react-markdown": "9.0.1"
  },
  "devDependencies": {
    "@types/react": "18.2.37",
    "@types/react-dom": "18.2.15",
    "@vitejs/plugin-react": "4.2.0",
    "vite": "5.0.0",
    "vitest": "1.0.4",
    "@vitest/ui": "1.0.4",
    "@testing-library/react": "14.1.2",
    "@testing-library/jest-dom": "6.1.5",
    "@testing-library/user-event": "14.5.1",
    "jsdom": "23.0.1",
    "eslint": "8.53.0",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-react-refresh": "0.4.4",
    "tailwindcss": "3.3.5",
    "autoprefixer": "10.4.16",
    "postcss": "8.4.31"
  }
}
